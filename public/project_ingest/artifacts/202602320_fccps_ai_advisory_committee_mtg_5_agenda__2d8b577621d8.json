      "heading_path": [],
      "section_id": "sec_0029",
      "text": "what wording should be tightened"
    },
    {
      "heading_path": [],
      "section_id": "sec_0030",
      "text": "6. Sort issues into three buckets"
    },
    {
      "heading_path": [],
      "section_id": "sec_0031",
      "text": "For each major topic, sort into:"
    },
    {
      "heading_path": [],
