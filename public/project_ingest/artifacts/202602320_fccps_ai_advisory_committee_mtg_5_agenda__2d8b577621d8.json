    {
      "heading_path": [],
      "section_id": "sec_0021",
      "text": "privacy / approved tools / notice"
    },
    {
      "heading_path": [],
      "section_id": "sec_0022",
      "text": "equity / access / accommodations"
    },
    {
      "heading_path": [],
      "section_id": "sec_0023",
      "text": "implementation / review cadence"
    },
    {
      "heading_path": [],
      "section_id": "sec_0024",
      "text": "5. Draft risk register walk-through"
    },
    {
      "heading_path": [],
      "section_id": "sec_0025",
      "text": "Use the retrospective first-pass risk register as a discussion draft:"
