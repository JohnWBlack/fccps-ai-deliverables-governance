      "text": "4. Review of written member inputs by theme"
    },
    {
      "heading_path": [],
      "section_id": "sec_0016",
      "text": "Discuss member submissions in clustered themes rather than by person."
    },
    {
      "heading_path": [],
      "section_id": "sec_0017",
